{
  "name": "L'Atelier du Mécano — Mécano 73",
  "short_name": "Mécano 73",
  "description": "Dépannage 24h/24 7j/7 avec dépanneuse, remorquage, mécanique auto, diagnostic électronique et location de véhicules à La Rochette (73110). Intervention rapide sur La Rochette, Pontcharra, Goncelin, Le Cheylas, Le Touvet, La Terrasse, Crolles, Brignoud, Grenoble, Chambéry, Détrier, Albertville, Frontenex, Les Marches, Montmélian. Tél : 06 68 83 36 87",
  "start_url": "/?source=pwa",
  "id": "/?app=mecano73",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0a1628",
  "theme_color": "#f4700a",
  "lang": "fr",
  "dir": "ltr",
  "prefer_related_applications": false,

  "categories": ["business", "productivity", "utilities", "navigation", "lifestyle", "travel"],

  "icons": [
    { "src": "icon-72.png",  "sizes": "72x72",   "type": "image/png", "purpose": "any" },
    { "src": "icon-96.png",  "sizes": "96x96",   "type": "image/png", "purpose": "any" },
    { "src": "icon-128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "icon-144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "icon-152.png", "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-384.png", "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],

  "scope_extensions": [
    { "origin": "https://latelierdumecano.netlify.app" },
    { "origin": "https://l-atelier-du-mecano.netlify.app" },
    { "origin": "https://l-atelier-du-mecano-app-android.netlify.app" },
    { "origin": "https://markito738.github.io" },
    { "origin": "*.atelier-du-mecano.fr" }
  ],

  "shortcuts": [
    {
      "name": "🚨 Dépannage Urgent",
      "short_name": "Urgence",
      "description": "Appeler immédiatement pour un dépannage 24h/24",
      "url": "/?action=urgent",
      "icons": [
        { "src": "shortcut-urgent-96.png",  "sizes": "96x96",   "type": "image/png" },
        { "src": "shortcut-urgent-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "🚗 Réserver un véhicule",
      "short_name": "Réserver",
      "description": "Réserver une voiture, un fourgon ou un utilitaire",
      "url": "/?action=reserver#location",
      "icons": [
        { "src": "shortcut-reserver-96.png",  "sizes": "96x96",   "type": "image/png" },
        { "src": "shortcut-reserver-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "📅 Mon planning",
      "short_name": "Planning",
      "description": "Voir les disponibilités de la flotte",
      "url": "/?action=planning#planning",
      "icons": [
        { "src": "shortcut-planning-96.png",  "sizes": "96x96",   "type": "image/png" },
        { "src": "shortcut-planning-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "💬 Laisser un avis",
      "short_name": "Avis",
      "description": "Donner mon avis sur le service",
      "url": "/?action=avis#avis",
      "icons": [
        { "src": "shortcut-avis-96.png",  "sizes": "96x96",   "type": "image/png" },
        { "src": "shortcut-avis-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ],

  "protocol_handlers": [
    { "protocol": "mailto",     "url": "/?compose=%s" },
    { "protocol": "sms",        "url": "/?sms=%s" },
    { "protocol": "web+mecano", "url": "/?handler=%s" },
    { "protocol": "web+mypwa",  "url": "/?app=%s" }
  ],

  "share_target": {
    "action": "/?share=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "documents", "accept": ["image/*", "application/pdf"] }
      ]
    }
  },

  "file_handlers": [
    {
      "action": "/?fileHandler=1",
      "accept": {
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png":  [".png"],
        "application/pdf": [".pdf"]
      },
      "launch_type": "single-client"
    }
  ],

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "edge_side_panel": {
    "preferred_width": 420
  },

  "handle_links": "preferred",
  "related_applications": []
}
